SELECT "id", "name"
FROM "my_schema"."my_table"
原始计划:
LogicalProject(id=[$0], name=[$1], age=[$2])
  LogicalFilter(condition=[>($3, 50000)])
    LogicalFilter(condition=[AND(>($2, 18), LIKE($1, 'A%'))])
      LogicalTableScan(table=[[my_schema, my_table]])

生成优化前的 SQL: 
SELECT id, name, age
FROM (SELECT *
FROM my_schema.my_table
WHERE age > 18 AND name LIKE 'A%') AS t
WHERE salary > 50000

优化后计划:
LogicalProject(id=[$0], name=[$1], age=[$2])
  LogicalFilter(condition=[AND(>($2, 18), LIKE($1, 'A%'), >($3, 50000))])
    LogicalTableScan(table=[[my_schema, my_table]])

生成优化后的 SQL:
SELECT id, name, age
FROM my_schema.my_table
WHERE age > 18 AND name LIKE 'A%' AND salary > 50000
sql: SELECT "age", SUM("id") AS "total"
FROM "my_schema"."my_table"
GROUP BY "age"
Generated SQL: SELECT "my_table"."name", "my_department"."dept_name"
FROM "my_schema"."my_table"
INNER JOIN "my_schema"."my_department" ON "my_table"."id" = "my_department"."dept_id"
原始计划:
LogicalProject(ID=[$0], NAME=[$1], AGE=[$2])
  LogicalFilter(condition=[>($3, 50000)])
    LogicalProject(id=[$0], name=[$1], age=[$2], salary=[$3])
      LogicalFilter(condition=[AND(>($2, 18), LIKE($1, 'A%'))])
        LogicalTableScan(table=[[my_schema, my_table]])

生成优化前的 SQL: 
SELECT id AS ID, name AS NAME, age AS AGE
FROM (SELECT *
FROM my_schema.my_table
WHERE age > 18 AND name LIKE 'A%') AS t0
WHERE salary > 50000

优化后计划:
LogicalProject(ID=[$0], NAME=[$1], AGE=[$2])
  LogicalCalc(expr#0..3=[{inputs}], expr#4=[18], expr#5=[>($t2, $t4)], expr#6=['A%'], expr#7=[LIKE($t1, $t6)], expr#8=[AND($t5, $t7)], expr#9=[50000], expr#10=[>($t3, $t9)], expr#11=[AND($t8, $t10)], proj#0..3=[{exprs}], $condition=[$t11])
    LogicalTableScan(table=[[my_schema, my_table]])

生成优化后的 SQL:
SELECT id AS ID, name AS NAME, age AS AGE
FROM my_schema.my_table
WHERE age > 18 AND name LIKE 'A%' AND salary > 50000
